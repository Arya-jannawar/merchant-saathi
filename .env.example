# Merchant Saathi - environment template
# Copy to .env.local (never commit .env.local). No NEXT_PUBLIC_ prefix is used: all values stay server-side.

# SQLite database file location (relative to project root or absolute path)
DATABASE_PATH=./data/merchant-saathi.sqlite

# AI adapter mode: "fixture" (default, no credentials needed, visibly labeled) or "live"
AI_MODE=fixture

# Live mode only - any OpenAI-compatible chat-completions endpoint.
# All three values are required in live mode (key is a server-side API key, not a chat login).
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# DEMO_MODE=true pins the app clock to the fixture time (2026-11-06T19:00:00+05:30)
# so the demo windows stay complete regardless of the real wall clock.
DEMO_MODE=true

# Optional explicit clock override (ISO 8601). Takes precedence over the fixture clock.
# Example: DEMO_NOW=2026-11-06T19:00:00+05:30
DEMO_NOW=
